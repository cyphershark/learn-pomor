{
  "id": "intro_01",
  "title": {
    "ru": "Первые отличия",
    "pomor": "Перьвы отличья"
  },
  "description": {
    "ru": "Знакомимся с основными звуковыми отличиями поморской говори от русского языка."
  },
  "grammar_note": {
    "ru": "В поморском языке нет звука [ч] — вместо него используется [ц]. Например, русское «чай» звучит как «цяй», «печь» — как «пець». Это одно из самых заметных отличий, которое вы встретите почти в каждом предложении."
  },
  "words": [
    {
      "id": "w_intro_001",
      "pomor": "цяй",
      "ru": "чай",
      "note_ru": "ч → ц — базовый фонетический сдвиг",
      "example": {
        "pomor": "Давай цяю попьём.",
        "ru": "Давай чаю попьём."
      },
      "tags": ["noun", "food", "phonetic_shift"]
    },
    {
      "id": "w_intro_002",
      "pomor": "пець",
      "ru": "печь",
      "note_ru": "ч → ц в конце слова",
      "example": {
        "pomor": "В пеци огонь горит.",
        "ru": "В печи огонь горит."
      },
      "tags": ["noun", "home", "phonetic_shift"]
    },
    {
      "id": "w_intro_003",
      "pomor": "ноць",
      "ru": "ночь",
      "note_ru": "ч → ц в конце слова",
      "example": {
        "pomor": "Ноць была светла.",
        "ru": "Ночь была светла."
      },
      "tags": ["noun", "time", "phonetic_shift"]
    },
    {
      "id": "w_intro_004",
      "pomor": "доцка",
      "ru": "дочка",
      "note_ru": "ч → ц перед согласной",
      "example": {
        "pomor": "Доцка домой пришла.",
        "ru": "Дочка домой пришла."
      },
      "tags": ["noun", "family", "phonetic_shift"]
    }
  ],
