{
  "id": "intro_02",
  "title": {
    "ru": "Куда делось Щ?",
    "pomor": "Куды делось Щ?"
  },
  "description": {
    "ru": "Второе важное отличие: в поморском нет звука [щ]. Также повторяем замену [ч] на [ц] из прошлого урока."
  },
  "grammar_note": {
    "ru": "В поморском языке нет звука [щ]. Вместо него используется [ш] или [шш]. Например, русское «ещё» звучит как «ешшо», «щука» — как «шшука». Вместе с заменой [ч] → [ц] из прошлого урока, это означает, что шипящие в поморском значительно проще, чем в русском."
  },
  "words": [
    {
      "id": "w_intro_005",
      "pomor": "ешшо",
      "ru": "ещё",
      "note_ru": "щ → шш — второй ключевой фонетический сдвиг",
      "example": {
        "pomor": "Дай ешшо цяю.",
        "ru": "Дай ещё чаю."
      },
      "tags": ["adverb", "phonetic_shift"]
    },
    {
      "id": "w_intro_006",
      "pomor": "шшука",
      "ru": "щука",
      "note_ru": "щ → шш в начале слова",
      "example": {
        "pomor": "Шшуку поймали большу.",
