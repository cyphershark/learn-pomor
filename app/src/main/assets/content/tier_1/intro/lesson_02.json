      "note_ru": "щ → шш в конце слова",
      "example": {
        "pomor": "Товаришш мой пришёл.",
        "ru": "Товарищ мой пришёл."
      },
      "tags": ["noun", "people", "phonetic_shift"]
    },
    {
      "id": "w_intro_008",
